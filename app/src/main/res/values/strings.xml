    <!-- Dentist step by urgency -->
    <string name="plan_step_dentist_high">Visit a dentist within the next 2 weeks, and sooner if you feel pain, swelling or sensitivity.</string>
    <string name="plan_step_dentist_medium">Book a dentist appointment within the next 1 to 3 months.</string>
    <string name="plan_step_dentist_low">Mention these findings at your next routine dental check-up (every 6 months).</string>

    <!-- Condition-specific steps -->
    <string name="plan_step_caries_1">Cut back on sugary and acidic foods and drinks, especially between meals and before bed.</string>
    <string name="plan_step_caries_2">Brush the affected teeth gently with fluoride toothpaste, and avoid chewing hard foods on them until a dentist has checked them.</string>
    <string name="plan_step_calculus_1">Book a professional cleaning (scaling): tartar cannot be removed by brushing at home.</string>
    <string name="plan_step_calculus_2">Brush along the gumline twice a day and use an antibacterial mouthwash to slow new buildup.</string>
    <string name="plan_step_gingivitis_1">Brush gently along the gumline twice a day and floss daily to remove plaque. Bleeding gums often improve with regular, gentle cleaning.</string>
    <string name="plan_step_gingivitis_2">Rinse with an antibacterial mouthwash, and avoid smoking and tobacco while your gums heal.</string>

    <!-- General prevention steps (always last) -->
    <string name="plan_step_general_1">Brush for 2 minutes, twice a day, with fluoride toothpaste.</string>
    <string name="plan_step_general_2">Floss daily and drink plenty of water, especially after meals.</string>

