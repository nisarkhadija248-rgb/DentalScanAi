    <string name="plan_quick_tips">Quick Tips</string>
    <string name="tip_tap_more">Read more</string>
    <string name="tip_tap_less">Show less</string>

    <string name="tip_caries_1_title">Cut the sugar</string>
    <string name="tip_caries_1_line">Sugar feeds decay bacteria.</string>
    <string name="tip_caries_1_full">Sugary snacks and drinks feed the bacteria that cause cavities. Keep sweets to mealtimes rather than all day, and rinse with water afterwards.</string>
    <string name="tip_caries_2_title">Fluoride helps</string>
    <string name="tip_caries_2_line">Fluoride strengthens enamel.</string>
    <string name="tip_caries_2_full">Use a fluoride toothpaste twice a day. Fluoride helps repair early enamel damage and makes teeth more resistant to acid. Avoid rinsing with water straight after brushing.</string>
    <string name="tip_caries_3_title">Do not wait</string>
    <string name="tip_caries_3_line">Cavities do not heal on their own.</string>
    <string name="tip_caries_3_full">Decay does not reverse once it has gone through the enamel. A small filling now is much simpler than a root canal later, so book a visit soon.</string>

    <string name="tip_calculus_1_title">Get it scaled</string>
    <string name="tip_calculus_1_line">Only a dentist can remove tartar.</string>
    <string name="tip_calculus_1_full">Hardened tartar sticks to teeth and can only be removed by professional scaling. Brushing harder will not remove it and can damage your gums.</string>
    <string name="tip_calculus_2_title">Brush the gumline</string>
    <string name="tip_calculus_2_line">Angle the brush toward the gums.</string>
    <string name="tip_calculus_2_full">Hold the brush at about 45 degrees to the gumline and use short, gentle strokes. Tartar builds up fastest behind the lower front teeth.</string>
    <string name="tip_calculus_3_title">Regular cleanings</string>
    <string name="tip_calculus_3_line">Every 6 months keeps it away.</string>
    <string name="tip_calculus_3_full">A professional cleaning about every 6 months stops tartar from building up and protects your gums.</string>

    <string name="tip_gingivitis_1_title">Be gentle</string>
    <string name="tip_gingivitis_1_line">Soft brush, light pressure.</string>
    <string name="tip_gingivitis_1_full">Use a soft toothbrush and light pressure along the gumline. Brushing too hard can make gums recede.</string>
    <string name="tip_gingivitis_2_title">Floss daily</string>
    <string name="tip_gingivitis_2_line">Cleans where brushing cannot reach.</string>
    <string name="tip_gingivitis_2_full">Floss once a day between all teeth, curving the floss around each tooth. Your gums may bleed at first, which usually settles within a couple of weeks.</string>
    <string name="tip_gingivitis_3_title">Watch for signs</string>
    <string name="tip_gingivitis_3_line">Do not ignore bleeding or swelling.</string>
    <string name="tip_gingivitis_3_full">Red, swollen or bleeding gums, or persistent bad breath, mean the inflammation is still active. See a dentist if they do not improve.</string>

    <string name="tip_general_1_title">Regular check-ups</string>
    <string name="tip_general_1_line">See a dentist every 6 months.</string>
    <string name="tip_general_1_full">Regular check-ups catch problems early, when treatment is simplest. Make a visit every 6 months a habit.</string>
