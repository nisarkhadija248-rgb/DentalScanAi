<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/resultScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Scan image -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_variant">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/resultImageView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:maxHeight="400dp"
                        android:minHeight="200dp"
                        android:scaleType="fitCenter"/>

                    <!-- Scanning animation overlay (only shown while analysing) -->
                    <FrameLayout
                        android:id="@+id/scanOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <View
                            android:id="@+id/scanBeam"
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:background="@drawable/bg_scan_beam"/>

                    </FrameLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Condition color legend -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/caries_red"/>

                <TextView
                    android:id="@+id/legendCariesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="16dp"
                    android:text="Caries"
                    android:textAppearance="@style/TextAppearance.App.Caption"/>

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/calculus_orange"/>

                <TextView
                    android:id="@+id/legendCalculusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="16dp"
                    android:text="Calculus"
                    android:textAppearance="@style/TextAppearance.App.Caption"/>

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/gingivitis_yellow"/>

                <TextView
                    android:id="@+id/legendGingivitisText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Gingivitis"
                    android:textAppearance="@style/TextAppearance.App.Caption"/>

            </LinearLayout>

            <!-- Captured photos: scrollable thumbnail row (tap to enlarge) -->
            <LinearLayout
                android:id="@+id/photosSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/photosLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Captured photos"
                    android:textAppearance="@style/TextAppearance.App.Label"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/photosList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>

                </HorizontalScrollView>

            </LinearLayout>

            <!-- Result header card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/resultCard"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Several conditions found across the angles: "2 conditions detected" -->
                    <TextView
                        android:id="@+id/multiConditionsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textColor="?attr/colorPrimary"
                        android:visibility="gone"/>

                    <!-- Condition chip + severity chip -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/conditionChip"
                            style="@style/Widget.App.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:visibility="gone"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/severityChip"
                            style="@style/Widget.App.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:visibility="gone"/>

                    </LinearLayout>

                    <!-- Gauge (left) + title and confidence text (right) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Animated circular confidence gauge (shown once a result is ready) -->
                        <FrameLayout
                            android:id="@+id/gaugeContainer"
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:layout_marginEnd="16dp"
                            android:visibility="gone">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/confidenceGauge"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                app:indicatorSize="88dp"
                                app:trackColor="@color/surface_variant"
                                app:trackCornerRadius="6dp"
                                app:trackThickness="9dp"/>

                            <TextView
                                android:id="@+id/confidenceGaugeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="0%"
                                android:textAppearance="@style/TextAppearance.App.Title"
                                android:textSize="20sp"/>

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Title (display name) with optional healthy icon -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/resultIcon"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_marginEnd="12dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_check_circle"
                                    android:visibility="gone"
                                    app:tint="@color/healthy_green"/>

                                <TextView
                                    android:id="@+id/resultText"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Analyzing..."
                                    android:textAppearance="@style/TextAppearance.App.Headline"/>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/confidenceText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Please wait"
                                android:textAppearance="@style/TextAppearance.App.Body"
                                android:textColor="@color/text_secondary"/>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Loading state -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/loadingIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:indeterminate="true"
                        app:indicatorColor="?attr/colorPrimary"
                        app:trackColor="@color/surface_variant"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp"/>

                    <!-- Confidence bar (shown once a result is ready) -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/confidenceBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:visibility="gone"
                        app:trackColor="@color/surface_variant"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Findings: every region the model detected, with its confidence -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/findingsCard"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/findingsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detected regions"
                        android:textAppearance="@style/TextAppearance.App.Label"/>

                    <LinearLayout
                        android:id="@+id/findingsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Action Plan: neutral card, stripe colored by condition, icon shows urgency -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/actionPlanCard"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/actionPlanStripe"
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="@color/primary"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/actionPlanIcon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_info"
                                app:tint="?attr/colorPrimary"/>

                            <TextView
                                android:id="@+id/actionPlanTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Action Plan"
                                android:textAppearance="@style/TextAppearance.App.Title"/>

                        </LinearLayout>

                        <!-- Headline, e.g. "Urgent: Visit a dentist within 2 weeks" -->
                        <TextView
                            android:id="@+id/actionPlanText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textStyle="bold"/>

                        <!-- Combined plans only: "2 conditions found: Caries · Calculus" -->
                        <TextView
                            android:id="@+id/planFoundText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            android:visibility="gone"/>

                        <!-- Progress: "2 of 4 steps completed" -->
                        <TextView
                            android:id="@+id/planProgressText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:textAppearance="@style/TextAppearance.App.Label"/>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/planProgressBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:max="1"
                            app:trackColor="@color/surface_variant"
                            app:trackCornerRadius="3dp"
                            app:trackThickness="6dp"/>

                        <!-- Step cards are added here from code -->
                        <LinearLayout
                            android:id="@+id/planStepsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"/>

                        <!-- Shown when every step is ticked -->
                        <LinearLayout
                            android:id="@+id/planCongratsRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_banner"
                            android:backgroundTint="@color/healthy_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/planCongratsIcon"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginEnd="12dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/healthy_green"/>

                            <TextView
                                android:id="@+id/planCongratsText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextAppearance.App.Title"
                                android:textColor="@color/healthy_green"
                                android:textSize="16sp"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Quick tips: horizontal row of compact cards, specific to the detected condition(s) -->
            <LinearLayout
                android:id="@+id/tipsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tipsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Tips"
                    android:textAppearance="@style/TextAppearance.App.Title"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:paddingTop="2dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/tipsList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal"/>

                </HorizontalScrollView>

            </LinearLayout>

            <!-- About this condition -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/conditionInfoCard"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header row: whole row toggles the content -->
                    <LinearLayout
                        android:id="@+id/conditionInfoHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_info"
                            app:tint="?attr/colorPrimary"/>

                        <TextView
                            android:id="@+id/conditionInfoTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="About this condition"
                            android:textAppearance="@style/TextAppearance.App.Title"/>

                        <TextView
                            android:id="@+id/conditionInfoToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="Show"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            android:textColor="?attr/colorPrimary"/>

                        <ImageView
                            android:id="@+id/conditionInfoChevron"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_expand_more"
                            app:tint="?attr/colorPrimary"/>

                    </LinearLayout>

                    <!-- Expandable content -->
                    <LinearLayout
                        android:id="@+id/conditionInfoContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider"/>

                        <TextView
                            android:id="@+id/conditionWhatTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="4dp"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:text="Overview"
                            android:textAppearance="@style/TextAppearance.App.Label"/>

                        <TextView
                            android:id="@+id/conditionWhatText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.App.Body"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:background="@color/divider"/>

                        <TextView
                            android:id="@+id/conditionCauseTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="4dp"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:text="Causes"
                            android:textAppearance="@style/TextAppearance.App.Label"/>

                        <TextView
                            android:id="@+id/conditionCauseText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/text_secondary"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:background="@color/divider"/>

                        <TextView
                            android:id="@+id/conditionPreventTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="4dp"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:text="Prevention"
                            android:textAppearance="@style/TextAppearance.App.Label"/>

                        <TextView
                            android:id="@+id/conditionPreventText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/text_secondary"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Disclaimer (muted caption at the bottom) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info"
                    app:tint="@color/text_secondary"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Disclaimer: This app is for awareness only and does not replace professional dental diagnosis."
                    android:textAppearance="@style/TextAppearance.App.Caption"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom action bar. No padding of its own, so it collapses when both buttons are GONE (view-only mode). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/retakeButton"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:text="@string/retake"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart"
            app:iconPadding="8dp"/>

        <Button
            android:id="@+id/saveButton"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:text="@string/save_scan"
            app:icon="@drawable/ic_save"
            app:iconGravity="textStart"
            app:iconPadding="8dp"/>

    </LinearLayout>

</LinearLayout>
