<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full screen camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Guide frame overlay: white corner brackets, green when capture is ready -->
    <View
        android:id="@+id/guideFrame"
        android:layout_width="300dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:background="@drawable/camera_guide_frame"/>

    <!-- TOP: step indicator + progress + guidance, then the step illustration below it -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scrim_top"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <!-- Step counter + step name + progress dots -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/stepCounterText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="Step 1 of 5"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/stepNameText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Front View"
                    android:textColor="@color/primary_light"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <!-- Progress dots: filled = done, ring = current, dim = upcoming -->
                <LinearLayout
                    android:id="@+id/capturedDotsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/dot_todo"/>

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/dot_todo"/>

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/dot_todo"/>

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/dot_todo"/>

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/dot_todo"/>

                </LinearLayout>

                <!-- Voice mute / unmute -->
                <ImageView
                    android:id="@+id/cameraMuteButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_circle_white"
                    android:backgroundTint="#33FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_volume_up"
                    app:tint="@android:color/white"/>

                <!-- Flashlight (rear camera torch) -->
                <ImageView
                    android:id="@+id/flashButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_circle_white"
                    android:backgroundTint="#33FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_flashlight_off"
                    android:visibility="gone"
                    app:tint="@android:color/white"/>

            </LinearLayout>

            <!-- Progress bar -->
            <ProgressBar
                android:id="@+id/stepProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginBottom="12dp"
                android:max="5"
                android:progress="0"
                android:progressBackgroundTint="#33FFFFFF"
                android:progressTint="@color/primary_light"/>

            <!-- Guidance pill (tinted from code: green = ready, teal = adjust) -->
            <TextView
                android:id="@+id/guidanceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_guidance_pill"
                android:backgroundTint="@color/primary_dark"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="Position your teeth in the frame"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Step illustration, anchored under the top panel so it never overlaps the guide frame -->
        <androidx.cardview.widget.CardView
            android:id="@+id/illustrationCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_illustration_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:id="@+id/stepIllustrationEmoji"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_face"
                    app:tint="@android:color/white"/>

                <TextView
                    android:id="@+id/stepIllustrationText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Face camera directly"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- BOTTOM: instruction + Skip / Capture -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="32dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/stepInstructionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:text="Open your mouth and face the camera directly"
            android:textColor="@android:color/white"
            android:textSize="14sp"/>

        <!-- Tip shown while the camera is not zoomed in -->
        <TextView
            android:id="@+id/zoomHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:textColor="@color/primary_light"
            android:textSize="12sp"/>

        <!-- Zoom: minus, slider, plus, current zoom. Pinching the preview works too. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/zoomMinus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_white"
                android:backgroundTint="#33FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_zoom_minus"
                app:tint="@android:color/white"/>

            <SeekBar
                android:id="@+id/zoomSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progressBackgroundTint="#55FFFFFF"
                android:progressTint="@color/primary_light"
                android:thumbTint="@android:color/white"/>

            <ImageView
                android:id="@+id/zoomPlus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_white"
                android:backgroundTint="#33FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_zoom_plus"
                app:tint="@android:color/white"/>

            <TextView
                android:id="@+id/zoomText"
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="1.0x"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/skipButton"
                style="@style/Widget.App.Button.OnPrimary"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Skip"
                android:textSize="15sp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/captureButton"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="2"
                android:enabled="false"
                android:text="Capture"
                android:textColor="@color/capture_button_content"
                app:backgroundTint="@color/capture_button_bg"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_camera"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/capture_button_content"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
